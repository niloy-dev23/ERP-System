# =============================================================================
# Express / Node.js backend
# =============================================================================
# Keep these committed: package.json, package-lock.json, source code, config,
# swagger.js, and swagger-output.json.
#
# NOTE: `.env` is currently tracked by Git. Adding it below only prevents NEW
# files from being tracked. To stop tracking the existing file (recommended,
# since it contains secrets), run:
#     git rm --cached .env
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/

# Yarn (Berry) internals
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn-integrity

# pnpm
.pnpm-store/
.pnpm-debug.log*

# npm
.npm/
npm-debug.log*
lerna-debug.log*

# Alternate package managers' debug logs
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# Environment variables & secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert
id_rsa
id_rsa.*
.id_rsa

# Tool credentials / local registry auth
.npmrc
.sentryclirc
.netrc

# -----------------------------------------------------------------------------
# Build outputs & generated artifacts
# -----------------------------------------------------------------------------
# swagger-output.json is intentionally NOT ignored: it is generated by
# `npm run swagger` and tracked as part of the API contract.
dist/
build/
out/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Logs, runtime files & caches
# -----------------------------------------------------------------------------
logs/
*.log
pids/
*.pid
*.pid.lock
*.seed
.node_repl_history
.eslintcache
.stylelintcache
.prettiercache
.cache/
.tmp/
.temp/
tmp/
temp/

# pm2 process manager
.pm2/

# -----------------------------------------------------------------------------
# Tests / coverage
# -----------------------------------------------------------------------------
coverage/
.nyc_output/

# -----------------------------------------------------------------------------
# IDE, editors & tooling
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
.project
.classpath
.settings/
.factorypath
.history/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux removable-media / desktop artifacts
.fuse_hidden*
.Trash-*
lost+found/
