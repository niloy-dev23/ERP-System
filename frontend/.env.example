# Where the Express backend is listening (used by the Next.js rewrite proxy)
BACKEND_URL=http://localhost:8000

# The API prefix mounted in the backend (routes/main.js -> API_URL)
BACKEND_API_PREFIX=/api/v1

# Public link used by the in-app "API reference" shortcut to Swagger UI
NEXT_PUBLIC_API_DOCS_URL=http://localhost:8000/api-docs
