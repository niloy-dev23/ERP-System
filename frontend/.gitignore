# =============================================================================
# Next.js 16 / React 19 / TypeScript frontend
# =============================================================================
# Keep these committed: package.json, package-lock.json, source code, config,
# .env.example, README.md, and public assets.
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn-integrity
.pnpm-store/
/.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -----------------------------------------------------------------------------
# Next.js build output
# -----------------------------------------------------------------------------
/.next/
/out/
/build
/dist
/.turbo/
*.tsbuildinfo

# Generated by Next.js on every dev/build run
next-env.d.ts

# -----------------------------------------------------------------------------
# Environment variables & secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.local.example
!.env.*.example

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert

# Tool credentials
.npmrc
.sentryclirc
.netrc

# -----------------------------------------------------------------------------
# Hosting platforms
# -----------------------------------------------------------------------------
.vercel
.netlify

# -----------------------------------------------------------------------------
# Logs, caches & temporary files
# -----------------------------------------------------------------------------
logs/
*.log
.eslintcache
.stylelintcache
.prettiercache
.cache/
.parcel-cache/
.tmp/
temp/
tmp/

# -----------------------------------------------------------------------------
# Tests & coverage
# -----------------------------------------------------------------------------
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/cypress/videos/
/cypress/screenshots/
/cypress/downloads/

# Storybook
/storybook-static/

# -----------------------------------------------------------------------------
# IDE, editors & tooling
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
.project
.classpath
.settings/
.factorypath
.history/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux removable-media / desktop artifacts
.fuse_hidden*
.Trash-*
lost+found/
